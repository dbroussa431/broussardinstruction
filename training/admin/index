<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BSA Admin Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>

body{
font-family:Arial;
background:#eef3fb;
margin:0;
}

.header{
background:#173f8a;
color:white;
padding:20px;
display:flex;
justify-content:space-between;
align-items:center;
}

.header h1{
margin:0;
}

.container{
max-width:1300px;
margin:auto;
padding:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
margin-bottom:20px;
}

.card{
background:white;
padding:20px;
border-radius:10px;
box-shadow:0 4px 12px rgba(0,0,0,.1);
}

.card h3{
margin:0;
color:#666;
}

.card span{
font-size:32px;
font-weight:bold;
}

.controls{
display:flex;
gap:10px;
margin-bottom:20px;
}

button{
padding:12px 16px;
border:none;
border-radius:8px;
cursor:pointer;
font-weight:bold;
}

.gold{background:#d4a11e}
.blue{background:#173f8a;color:white}

table{
width:100%;
border-collapse:collapse;
background:white;
}

th,td{
padding:12px;
border-bottom:1px solid #eee;
text-align:left;
}

th{
background:#f6f6f6;
}

.status{
padding:4px 10px;
border-radius:20px;
font-size:12px;
}

.paid{background:#d4f7df;color:#176c2b}
.unpaid{background:#ffe2e2;color:#8f1d1d}

.modal{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.4);
display:none;
align-items:center;
justify-content:center;
}

.modal-inner{
background:white;
padding:30px;
width:500px;
border-radius:12px;
}

.modal input, .modal select{
width:100%;
padding:10px;
margin-bottom:10px;
}

</style>
</head>

<body>

<div class="header">
<h1>BSA Admin</h1>
<button id="logoutBtn" class="gold">Logout</button>
</div>

<div class="container">

<div class="cards">

<div class="card">
<h3>Total Students</h3>
<span id="metricStudents">0</span>
</div>

<div class="card">
<h3>Pending Payments</h3>
<span id="metricPending">0</span>
</div>

<div class="card">
<h3>Paid Students</h3>
<span id="metricPaid">0</span>
</div>

<div class="card">
<h3>Revenue</h3>
<span id="metricRevenue">$0</span>
</div>

</div>

<div class="controls">
<button id="addStudentBtn" class="gold">Add Student</button>
<button id="refreshBtn" class="blue">Refresh</button>
<button id="exportBtn" class="blue">Export CSV</button>
<input id="searchInput" placeholder="Search student">
</div>

<table>
<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Tier</th>
<th>Price</th>
<th>Paid</th>
<th>Status</th>
<th>Progress</th>
<th>Actions</th>
</tr>
</thead>
<tbody id="studentTable"></tbody>
</table>

</div>


<div id="studentModal" class="modal">
<div class="modal-inner">

<h2>Add Student</h2>

<input id="studentName" placeholder="Name">
<input id="studentEmail" placeholder="Email">

<select id="tier">
<option value="FULL">Full ($150)</option>
<option value="DISC">Discount ($100)</option>
<option value="FREE">Free</option>
</select>

<select id="paymentStatus">
<option value="Paid">Paid</option>
<option value="Pending">Pending</option>
<option value="Waived">Waived</option>
</select>

<select id="portalStatus">
<option value="Active">Active</option>
<option value="Locked">Locked</option>
</select>

<button id="saveStudent" class="gold">Save</button>

</div>
</div>

<script type="module" src="admin.js"></script>

</body>
</html>
